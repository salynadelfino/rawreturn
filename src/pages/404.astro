---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Not found">
  <section class="nf wrap">
    <p class="mono mono--m meta">404</p>
    <h1 class="stamp mega">Not in<br />the pile.</h1>
    <p class="lede">This page doesn’t exist, or it was unpicked. Every piece ever made is still in the archive.</p>
    <div class="nf-actions">
      <Button href="/archive">The archive</Button>
      <Button href="/" variant="outline">Home</Button>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: 96px;
    display: grid;
    gap: 28px;
    align-content: center;
  }
  .nf-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
