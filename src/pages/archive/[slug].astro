---
/**
 * Piece page — an editorial case study with a shop in it.
 * Opening (gallery + sticky purchase) → The object → First life → The rebuild
 * → The founder's note → Technical record → Returned → neighbouring pieces.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import PurchaseModule from '../../components/PurchaseModule.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import FounderQuote from '../../components/FounderQuote.astro';
import SpecBlock from '../../components/SpecBlock.astro';
import ArchiveRecord from '../../components/ArchiveRecord.astro';
import Img from '../../components/Img.astro';
import Lines from '../../components/Lines.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import pieces, { editionLabel, formatPrice } from '../../data/pieces';
import type { Piece } from '../../data/pieces';
import { hasImage } from '../../data/images';

export const getStaticPaths = (() =>
  pieces.map((p, i) => ({
    params: { slug: p.slug },
    props: { piece: p, prev: pieces[i - 1], next: pieces[i + 1] },
  }))) satisfies GetStaticPaths;

interface Props {
  piece: Piece;
  prev?: Piece;
  next?: Piece;
}
const { piece: p, prev, next } = Astro.props;

const shots = [
  { src: p.images.front, alt: p.alt.front, label: 'Front' },
  p.images.back && hasImage(p.images.back) && { src: p.images.back, alt: p.alt.back!, label: 'Back' },
  p.images.detail && hasImage(p.images.detail) && { src: p.images.detail, alt: p.alt.detail!, label: 'Construction', wide: false },
].filter(Boolean) as Array<{ src: string; alt: string; label: string; wide?: boolean }>;

// PLACEHOLDER: process frames are shared studio images. Replace per piece with
// that piece's own unpicking / cutting / construction photographs.
const rebuild = [
  { src: 'process/02-unpick', alt: 'Panels unpicked from the first-life garments, stitch holes still visible.', label: 'Unpicked' },
  { src: 'process/04-cut', alt: 'Chalk marks and notches on the denim before cutting.', label: 'Marked & cut' },
  { src: 'process/05-rebuild', alt: 'Panels pinned together on the bench.', label: 'Pinned' },
];
if (p.attempts) {
  rebuild.push({ src: 'process/failed-sleeves', alt: 'Earlier attempts hanging on the workshop wall with numbered tags.', label: `Attempts · ${p.attempts}` });
}
const words = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const garmentsWord = words[p.garments] ?? String(p.garments);
---

<Base title={`${p.no} ${p.name}`} description={`${p.no} ${p.name}. ${p.description}`} image={p.images.front}>
  <!-- ─────────────────────────────── opening -->
  <section class="open wrap" aria-label={`${p.no} ${p.name}`}>
    <nav class="crumbs mono mono--s" aria-label="Breadcrumb">
      <a href="/archive">Archive</a> / <span aria-current="page">{p.no}</span>
    </nav>
    <div class="open-grid grid">
      <div class="open-gallery">
        <Gallery shots={shots} slug={p.slug} />
      </div>
      <div class="open-buy" role="region" aria-label="Purchase">
        <div class="sticky">
          <p class="open-no stamp" aria-hidden="true">{p.no}</p>
          <PurchaseModule piece={p} />
          <hr class="stitch" />
          <a href="#object" class="mono mono--m jump">The record of how it was made ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────── the object -->
  <section class="sec wrap" id="object" aria-labelledby="obj-title">
    <SectionLabel n="01" label="The object" aside={`${p.type} · ${editionLabel(p)}`} />
    <div class="grid obj-grid">
      <h2 id="obj-title" class="lede-xl" data-reveal>{p.description}</h2>
      <div class="obj-record" data-reveal style="--i:1">
        <ArchiveRecord piece={p} />
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────── first life -->
  <section class="sec on-stone" aria-labelledby="fl-title">
    <div class="wrap">
      <SectionLabel n="02" label="First life" aside={`Found ${p.found.place} · ${p.found.date}`} />
      <div class="grid fl-grid">
        <div class="fl-type">
          <Lines as="h2" id="fl-title" class="stamp h1" lines={[`${garmentsWord} ${p.garments === 1 ? 'garment' : 'garments'}`, '→ one object']} />
          <ol role="list" class="fl-list">
            {
              p.firstLife.map((g, i) => (
                <li data-reveal style={`--i:${i}`}>
                  <span class="mono meta">{String(i + 1).padStart(2, '0')}</span>
                  <span class="stamp">{g}</span>
                </li>
              ))
            }
          </ol>
          <p class="body-copy" data-reveal>
            Found in {p.found.place}, {p.found.date}. Chosen for weight, fade and repairs. All original wear is kept as found;
            nothing on this piece has been artificially distressed.
          </p>
        </div>
        <div class="fl-img">
          <!-- PLACEHOLDER: replace with this piece's first-life garments laid out before unpicking. -->
          <EditorialImage
            src="process/03-study"
            alt="The first-life garments taken apart and laid out, each panel tagged."
            ratio="3/2"
            sizes="(min-width: 900px) 58vw, 100vw"
            caption={`${p.no} · first life, catalogued`}
            parallax={0.06}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────── the rebuild -->
  <section class="sec wrap" aria-labelledby="rb-title">
    <SectionLabel n="03" label="The rebuild" aside={p.hours ? `${p.hours} hours` : 'Hours: running'} />
    <div class="rb-head grid">
      <Lines
        as="h2"
        id="rb-title"
        class="stamp h1 rb-title"
        lines={p.hours ? [`${p.panels ?? '—'} panels.`, `${p.hours} hours.`] : [`${p.panels ?? '—'} panels.`, 'Still counting.']}
      />
      <dl class="rb-dates record" data-reveal>
        <div><dt>Started</dt><dd>{p.started}</dd></div>
        <div><dt>Finished</dt><dd>{p.finished ?? <span data-day-since={p.started}>In work</span>}</dd></div>
        {p.attempts && <div><dt>Attempts</dt><dd>{p.attempts}</dd></div>}
      </dl>
    </div>
    <ol role="list" class="rb-strip">
      {
        rebuild.map((r, i) => (
          <li>
            <EditorialImage src={r.src} alt={r.alt} ratio={i % 2 ? '4/5' : '3/4'} sizes="(min-width: 900px) 25vw, 70vw" caption={`${String(i + 1).padStart(2, '0')} — ${r.label}`} i={i} />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ─────────────────────────────── the founder's note -->
  <section class="sec note-sec wrap" aria-label="The founder’s note">
    <SectionLabel n="04" label="From the bench" />
    <div class="note-wrap">
      <FounderQuote quote={p.note} cite={`The founder, on ${p.no}`} size="l" />
    </div>
  </section>

  <!-- ─────────────────────────────── technical record -->
  <section class="sec wrap" aria-labelledby="tr-title">
    <SectionLabel n="05" label="Technical record" aside={p.no} />
    <div class="grid tr-grid">
      <h2 id="tr-title" class="visually-hidden">Technical record</h2>
      <SpecBlock
        class="tr-a"
        title="First life"
        rows={[
          ['Garments', p.firstLife],
          ['Found', p.found.place],
          ['Date', p.found.date],
        ]}
      />
      <SpecBlock
        class="tr-b"
        title="Second life"
        rows={[
          ['Piece', `${p.no} ${p.name}`],
          ['Panels', p.panels ? String(p.panels) : null],
          ['Time', p.hours ? `${p.hours} hrs` : 'In work'],
          ['Attempts', p.attempts],
          ['Fit', p.fit],
          ['Material', p.material],
          ['Edition', editionLabel(p)],
          ['Made', 'London'],
          ['Price', p.status === 'available' ? formatPrice(p.price) : null],
        ]}
      />
      <div class="tr-care record" data-reveal>
        <p class="mono--m">Care</p>
        <p>Wash cold, inside out.<br />Do not tumble.<br />Hang to dry.</p>
        <p class="tr-tag">It has been worn before.<br />Wear it again.</p>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────── returned -->
  {
    p.images.returned && hasImage(p.images.returned) && (
      <section class="returned on-night" data-tone="dark" aria-labelledby="ret-title">
        <div class="ret-img" data-reveal="mask">
          <!-- PLACEHOLDER: replace with an editorial flash photograph of this piece worn on a London street at night. -->
          <Img src={p.images.returned} alt={p.alt.returned ?? ''} sizes="100vw" />
        </div>
        <div class="ret-text wrap">
          <p class="mono mono--m">06 — Returned</p>
          <h2 id="ret-title" class="stamp display">
            {p.returned ? (
              <>
                Now worn by
                <br />
                {p.returned.by}.
              </>
            ) : (
              <>
                Next worn
                <br />
                by you.
              </>
            )}
          </h2>
          <p class="mono">{p.returned ? `Returned ${p.returned.date} · Direct flash` : 'First life: someone else. Second life: you.'}</p>
        </div>
      </section>
    )
  }

  {
    p.status === 'in-work' && (
      <section class="sec wrap notify" id="notify" aria-labelledby="notify-title">
        <SectionLabel n="06" label="When it’s finished" />
        <div class="grid">
          <h2 id="notify-title" class="voice notify-title">One note when {p.no} comes off the bench. Nothing else.</h2>
          <div class="notify-form">
            <NewsletterForm id="notify" />
          </div>
        </div>
      </section>
    )
  }

  <!-- ─────────────────────────────── neighbours in the archive -->
  <nav class="seq wrap" aria-label="Archive sequence">
    {
      prev ? (
        <a href={`/archive/${prev.slug}`} class="seq-link">
          <span class="mono meta">← {prev.no}</span>
          <span class="stamp">{prev.name}</span>
        </a>
      ) : (
        <span />
      )
    }
    <a href="/archive" class="seq-mid mono mono--m">Archive</a>
    {
      next ? (
        <a href={`/archive/${next.slug}`} class="seq-link seq-next">
          <span class="mono meta">{next.no} →</span>
          <span class="stamp">{next.name}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>

<style>
  .open {
    padding-top: calc(var(--header-h) + 20px);
  }
  .crumbs {
    color: var(--ink-soft);
    margin-bottom: 16px;
  }
  .crumbs a {
    text-decoration: none;
  }
  .open-grid {
    row-gap: 32px;
    align-items: start;
  }
  .open-gallery {
    grid-column: 1 / span 7;
  }
  .open-buy {
    grid-column: 9 / span 4;
    align-self: stretch;
  }
  .sticky {
    position: sticky;
    top: calc(var(--header-h) + 20px);
    display: grid;
    gap: 24px;
  }
  .open-no {
    font-size: clamp(3rem, 6.4vw, 7rem);
    color: var(--raw-indigo);
    line-height: 0.82;
    animation: no-in 1.1s var(--ease-out) both;
  }
  @keyframes no-in {
    from {
      clip-path: inset(0 100% 0 0);
      transform: translateX(-12px);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .open-no {
      animation: none;
    }
  }
  .jump {
    text-decoration: none;
    letter-spacing: 0.1em;
  }

  .sec {
    padding-block: clamp(72px, 10vw, 150px);
  }
  .obj-grid {
    margin-top: clamp(32px, 4vw, 56px);
    row-gap: 40px;
    align-items: start;
  }
  .lede-xl {
    grid-column: 1 / span 6;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.3vw, 2.15rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .obj-record {
    grid-column: 8 / span 5;
  }

  .fl-grid {
    margin-top: clamp(32px, 4vw, 56px);
    row-gap: 40px;
  }
  .fl-type {
    grid-column: 1 / span 5;
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .fl-list li {
    display: grid;
    grid-template-columns: 4ch 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0 10px;
    border-top: 1px solid var(--rule-strong);
  }
  .fl-list .stamp {
    font-size: clamp(1.1rem, 1.7vw, 1.5rem);
  }
  .fl-img {
    grid-column: 7 / span 6;
  }

  .rb-head {
    margin-top: clamp(32px, 4vw, 56px);
    row-gap: 24px;
    align-items: end;
  }
  .rb-title {
    grid-column: 1 / span 7;
  }
  .rb-dates {
    grid-column: 9 / span 4;
  }
  .rb-dates div {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-top: 1px solid var(--rule);
  }
  .rb-dates dd {
    margin: 0;
  }
  .rb-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--gutter);
    margin-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .rb-strip li:nth-child(even) {
    margin-top: 12vh;
  }

  .note-sec {
    padding-block: clamp(56px, 8vw, 120px);
  }
  .note-wrap {
    margin-top: clamp(40px, 6vw, 80px);
    padding-left: calc((100% + var(--gutter)) / 12 * 2);
  }

  .tr-grid {
    margin-top: clamp(32px, 4vw, 56px);
    row-gap: 40px;
  }
  :global(.tr-a) {
    grid-column: 1 / span 4;
  }
  :global(.tr-b) {
    grid-column: 5 / span 5;
  }
  .tr-care {
    grid-column: 11 / span 2;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .tr-tag {
    color: var(--saddle);
  }

  .returned {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .ret-img {
    position: absolute;
    inset: 0;
  }
  .ret-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ret-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(12, 17, 29, 0.75));
  }
  .ret-text {
    position: relative;
    display: grid;
    gap: 18px;
    padding-bottom: clamp(32px, 5vw, 64px);
  }

  .notify-title {
    grid-column: 1 / span 6;
    margin-top: 40px;
  }
  .notify-form {
    grid-column: 8 / span 5;
    margin-top: 40px;
    align-self: end;
  }

  .seq {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: var(--gutter);
    padding-block: clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--rule-strong);
  }
  .seq-link {
    display: grid;
    gap: 8px;
    text-decoration: none;
  }
  .seq-link .stamp {
    font-size: clamp(1.1rem, 2.2vw, 2rem);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .seq-link:hover .stamp {
    transform: translateX(-6px);
  }
  .seq-next {
    text-align: right;
  }
  .seq-next:hover .stamp {
    transform: translateX(6px);
  }
  .seq-mid {
    text-decoration: none;
    letter-spacing: 0.1em;
  }

  @media (max-width: 899px) {
    .open-gallery,
    .open-buy,
    .lede-xl,
    .obj-record,
    .fl-type,
    .fl-img,
    .rb-title,
    .rb-dates,
    :global(.tr-a),
    :global(.tr-b),
    .tr-care,
    .notify-title,
    .notify-form {
      grid-column: 1 / -1;
    }
    .open-no {
      display: none;
    }
    .sticky {
      position: static;
    }
    .rb-strip {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
    }
    .rb-strip li:nth-child(even) {
      margin-top: 8vh;
    }
    .note-wrap {
      padding-left: 0;
    }
    .seq {
      grid-template-columns: 1fr 1fr;
    }
    .seq-mid {
      display: none;
    }
  }
</style>
