---
/**
 * Shop — a catalogued index, not a product grid. Filter by state; the default
 * shows what can be bought, followed by what is on the bench.
 */
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import Lines from '../components/Lines.astro';
import Button from '../components/Button.astro';
import { available, inWork, archiveOrder, totals } from '../data/pieces';

// lead with the piece that took longest; the rest stay newest first
const all = available();
const lead = all.reduce((a, b) => ((b.hours ?? 0) > (a.hours ?? 0) ? b : a));
const forSale = [lead, ...all.filter((p) => p !== lead)];
const current = inWork();
const recent = archiveOrder().filter((p) => p.status === 'returned').slice(0, 3);
const t = totals();
---

<Base title="Shop" description="Pieces available now from Raw Return. One of one, or small numbered editions, made in London from garments with a past.">
  <section class="head wrap">
    <div class="head-row">
      <p class="mono mono--m meta">Shop · {forSale.length} available · {t.pieces} made</p>
      <p class="mono mono--m meta">Updated as pieces come off the bench</p>
    </div>
    <Lines as="h1" class="stamp mega" lines={['Current', 'return']} />
    <p class="lede" data-reveal>
      Each piece is one of one, or a small numbered edition. When it’s gone, it stays in the archive with a record of
      where it went.
    </p>
  </section>

  <section class="index wrap ledger" aria-label="Available pieces">
    <div class="index-bar mono mono--m">
      <span>No. / Piece</span>
      <span class="hide-s">First life / Hours / Edition</span>
      <span>Price / Status</span>
    </div>
    <h2 class="visually-hidden">Available pieces</h2>
    <div class="index-grid">
      {
        forSale.map((p, i) => (
          <PieceCard piece={p} i={i} eager={i < 2} class={i === 0 ? 'lead' : ''} sizes={i === 0 ? '(min-width: 900px) 50vw, 100vw' : undefined} />
        ))
      }
    </div>
  </section>

  {
    current && (
      <section class="bench wrap" aria-labelledby="bench-title">
        <div class="bench-row">
          <p class="mono mono--m meta">On the bench</p>
          <h2 id="bench-title" class="stamp h1">{current.no}<br />{current.name}</h2>
          <p class="body-copy">{current.description}</p>
          <p class="mono">Started {current.started} · <span data-day-since={current.started}>In work</span></p>
          <Button href={`/archive/${current.slug}`} variant="outline">Follow it</Button>
        </div>
      </section>
    )
  }

  <section class="gone wrap" aria-labelledby="gone-title">
    <div class="gone-head">
      <h2 id="gone-title" class="mono mono--m">Recently returned</h2>
      <Button href="/archive" variant="link">The full archive</Button>
    </div>
    <div class="gone-grid">
      {recent.map((p, i) => <PieceCard piece={p} i={i} ratio="1/1" />)}
    </div>
  </section>
</Base>

<style>
  .head {
    padding-top: calc(var(--header-h) + clamp(24px, 4vw, 56px));
    padding-bottom: clamp(40px, 6vw, 80px);
    display: grid;
    gap: clamp(20px, 3vw, 36px);
  }
  .head-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 10px;
  }
  .lede {
    margin-left: auto;
    max-width: 38ch;
  }
  .index {
    padding-bottom: clamp(72px, 10vw, 140px);
  }
  .index-bar {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-block: 1px solid var(--rule-strong);
    margin-bottom: clamp(24px, 3vw, 40px);
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }
  .index-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(40px, 5vw, 72px) var(--gutter);
  }
  .index-grid > :global(.card) {
    grid-column: span 4;
  }
  .index-grid > :global(.card.lead) {
    grid-column: span 6;
    grid-row: span 2;
  }
  .index-grid > :global(.card:not(.lead)) {
    grid-column: span 3;
  }
  .bench {
    padding-block: clamp(56px, 8vw, 120px);
    border-top: 1px dashed var(--rule-strong);
  }
  .bench-row {
    display: grid;
    gap: 22px;
    justify-items: start;
    max-width: 760px;
  }
  .gone {
    padding-block: clamp(56px, 8vw, 120px) clamp(80px, 10vw, 140px);
    border-top: 1px solid var(--rule-strong);
  }
  .gone-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    letter-spacing: 0.1em;
  }
  .gone-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
  }
  @media (max-width: 899px) {
    .index-grid > :global(.card),
    .index-grid > :global(.card.lead),
    .index-grid > :global(.card:not(.lead)) {
      grid-column: span 6;
      grid-row: auto;
    }
    .index-grid > :global(.card.lead) {
      grid-column: 1 / -1;
    }
    .hide-s {
      display: none;
    }
    .gone-grid {
      grid-template-columns: 1fr 1fr;
    }
    .gone-grid > :global(:nth-child(3)) {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .index-grid > :global(.card),
    .index-grid > :global(.card:not(.lead)) {
      grid-column: 1 / -1;
    }
    .head-row p:last-child {
      display: none;
    }
  }
</style>
