---
/**
 * Photograph by registry key. Falls back to a labelled empty frame when the
 * file is missing, so a deleted placeholder never breaks a page.
 */
import { Image } from 'astro:assets';
import { getImage } from '../data/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  position?: string;
  [key: string]: unknown;
}
const {
  src,
  alt,
  sizes = '100vw',
  widths = [480, 800, 1200, 1600, 2200],
  loading = 'lazy',
  fetchpriority,
  class: cls,
  position,
  ...rest
} = Astro.props;
const meta = getImage(src);
const usable = meta ? widths.filter((w) => w <= meta.width) : [];
if (meta && !usable.includes(meta.width) && usable.length < widths.length) usable.push(meta.width);
---

{
  meta ? (
    <Image
      src={meta}
      alt={alt}
      widths={usable}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      class={cls}
      style={position ? `object-position:${position}` : undefined}
      {...rest}
    />
  ) : (
    <div class:list={['img-missing', cls]} role="img" aria-label={alt}>
      <span class="mono mono--s">{src}</span>
    </div>
  )
}

<style>
  .img-missing {
    width: 100%;
    height: 100%;
    min-height: 200px;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(135deg, #d9d1c1 0 1px, transparent 1px 12px), var(--ground-2);
    color: var(--ink-soft);
  }
</style>
